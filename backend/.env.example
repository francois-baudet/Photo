# Copier ce fichier en .env et remplir les valeurs. Ne jamais committer .env.
PORT=3000
DATABASE_URL=postgres://photo:MOT_DE_PASSE@localhost:5432/photo
# Longue chaîne aléatoire, par exemple : openssl rand -hex 48
JWT_SECRET=remplacer-par-une-longue-chaine-aleatoire
# Dossier des fichiers RAW, aperçus et miniatures (local, puis NAS plus tard)
STORAGE_DIR=../storage
