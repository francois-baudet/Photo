# Copier ce fichier en .env (à la racine du projet) et remplir les valeurs.
# Ne jamais committer .env.

# Mot de passe PostgreSQL. Utiliser uniquement des lettres et des chiffres
# (sinon il faut l'encoder dans DATABASE_URL).
DB_PASSWORD=

# Longue chaîne aléatoire : openssl rand -hex 48
JWT_SECRET=

# Dossier hôte des fichiers (RAW, aperçus, miniatures).
# Chemin local par défaut, ou un point de montage du NAS, par exemple /mnt/nas/photo
STORAGE_HOST_DIR=./storage
